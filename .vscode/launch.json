    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Локальный запуск сервера",
            "type": "debugpy",
            "request": "launch",
            "module": "server",
            "subProcess": true,
        },
        {
            "name": "Docker: Дебаггинг сервера",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "/app"
                }
            ],
            "preLaunchTask": "docker-run",
            "postDebugTask": "docker-stop: debug",
            "subProcess": true,
        },
    ]
}