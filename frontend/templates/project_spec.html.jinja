{# === Nav builder === #}
{% macro nav_section(group) %}
<li data-group-id="{{ group.id }}"><a href="#">{{ group.name }}</a></li>
{% if group.has_groups %}
  <li>
    <ul class="nav-subsection">
      {% for group in group.items %}
        {{ nav_section(group) }}
      {% endfor %}
    </ul>
  </li>
{% endif %}
{% endmacro %}

{# === Item Cards table builder === #}
{% macro content_tree(group, level=3) %}
<h{{ level }}>{{group.name}}</h{{ level }}>
{% if not group.items %}
  <div class="vertical-space L"></div>
{% elif group.has_items %}
  <ul class="product-grid">
  {% for item in group.items %}
    <li data-item-id="{{ item.id }}" {% if item.approved %}class="product-done"{% endif %}>
      <div>
        {# Stub link #}
        {# TODO(@soucelover): Incorporate ObjectsStorage when it's implemented #}
        <img src="{% if item.image is none %}{{ url_for('static', path='/media/konsol_s_yashhikami_08-scaled.jpg') }}{% else %}{{ item.image }}{% endif %}">
        <button type="button" class="add-wishlist">
          <svg class="icon" aria-hidden="true"><use href="#icon-add-wishlist"></use></svg>
        </button>
        <div class="comments">
          <div class="comments-list"></div>
          <form class="comments-form">
            <button type="button" class="comments-toggle" aria-label="Комментарий">
              <svg class="icon" aria-hidden="true"><use href="#icon-buttom-comments"></use></svg>
            </button>
            <textarea name="comment" placeholder="Комментарий" rows="1" autocomplete="off"></textarea>
            <button type="submit" class="comments-send" aria-label="Отправить комментарий">
              <svg class="icon" aria-hidden="true"><use href="#icon-send-comment"></use></svg>
            </button>
          </form>
        </div>
      </div>

      <hgroup>
        <a href="{{ item.link }}" target="_blank">{{ item.name }}</a>
        <div class="price">
          {% if item.tags %}
            <p>{{ item.tags | join(" &middot; ") }}</p>
          {% endif %}
          <p class="price-row" data-item-price="{{ item.price.amount }}" data-item-currency-code="{{ item.price.currency }}">
            <span class="price">
              {% if item.price is none %}
                В наличии
              {% else %}
                {{ item.price.html_formatted }}
              {% endif %}
            </span> &middot;
            <span class="quantity">{{ item.count }} шт</span>
          </p>
        </div>
      </hgroup>
    </li>
  {% endfor %}
  </ul>
  <div class="vertical-space L"></div>
{% else %}
  {% for item in group.items %}
    {{ content_tree(item, ([level + 1, 6]|min)) }}
  {% endfor %}
{% endif %}
{% endmacro %}

<!DOCTYPE html>
<html lang="ru">
  <head>        
    <title>{{ project.name }} &mdash; Таблица Комплектации</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- conect-file -->
    <link href="{{ url_for('static', path='/style.css') }}" rel="stylesheet" type="text/css" />
    <script src="{{ url_for('static', path='/script.js') }}" defer></script>
    <script src="{{ url_for('static', path='/login.js') }}" defer></script>
  </head>

  <body>
    <svg style="display: none" aria-hidden="true"> <!-- Рендер svg -->
      <symbol id="icon-add-wishlist" viewBox="0 0 508 506">
        <rect id="background" x="2" width="506" height="506" rx="253" fill="currentColor"/>
        <path id="plas" d="M267 241H405V266H267V403H242V266H105V241H242V103H267V241Z" fill="black"/>
      </symbol>

      <symbol id="icon-buttom-comments" viewBox="0 0 24 24">
        <rect id="background" x="0" width="24" height="24" rx="253" fill="white"/>
        <path id="мessage" 
          transform="translate(12 12) scale(0.8) translate(-12 -12)"
          d="M2.00049 7C2.00049 5.325 3.32549 4 5.00049 4H19.0005C20.6755 4 22.0005 5.325 22.0005 7V17C22.0005 18.675 20.6755 20 19.0005 20H6.80049L2.00049 24V7ZM8.00049 10.875V9.075H16.0005V10.875H8.00049ZM8.00049 14.875V13.075H14.0005V14.875H8.00049ZM3.87549 20.075L6.12549 18.175H19.0005C19.6255 18.175 20.1255 17.65 20.1255 17V7C20.1255 6.35 19.6255 5.825 19.0005 5.825H5.00049C4.37549 5.825 3.87549 6.35 3.87549 7V20.075Z"/>
      </symbol>

      <symbol id="icon-send-comment" viewBox="0 0 508 506">
        <rect id="background" x="2" width="506" height="506" rx="253" fill="white"/>
        <path id="arrow" d="M209 163L299 253L209 343" stroke="black" stroke-width="40" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
      </symbol>
    </svg>

    {% include "partials/project-topbar.html.jinja" %}

    <main data-project-id="{{ project.id }}">
      <div class="vertical-space XL"></div>
      
      <header>
        <p>{{ project.name }}</p>
        <div class="vertical-space S"></div>
        <h1>Таблица комплектации</h1>
        <div class="vertical-space S"></div>
        <p class="text-width">Таблица как маркетплейс: выбираешь, что нравится, 
          и видишь, сколько это будет стоить. Также можно увидеть, что уже утверждено, 
          или оставить комментарий</p>
        <div class="vertical-space M"></div>

        <nav class="nav-pages nav-pages-general">
          {% for cat in categories %}
            <a href="{{ url_for('read_project_category_page', id=project.id, index=loop.index) }}" {% if cat.id == category.id %}class="active"{% endif %}>{{ cat.name }}</a>
          {% endfor %}
        </nav>
      </header>

      <div class="vertical-space L"></div>

      <article class="page-of-table"> <!-- Страница таблицы -->
        <nav>
          <div>
            <ul class="nav-section">
            {% if category.has_groups %}
              {% for item in category.items %}
                {{ nav_section(item) }}
              {% endfor %}
            {% else %}
              {{ nav_section(category) }}
            {% endif %}
            </ul>
          </div>
          <!-- <h3>Мебель</h3> -->
          <div class="nav-subsection-row"></div>
        </nav>

        <article class="content"> <!-- Контент -->
          {% if category.has_groups %}
            {% for item in category.items %}
              {{ content_tree(item) }}
            {% endfor %}
          {% else %}
            {{ content_tree(category) }}
          {% endif %}
        </article>

        <aside class="cart-panel"> <!-- Карзина -->
          <section class="cart-items-approved" id="cart-items-approved">
            <h1>Утверждено</h1>
            <ul>
              <li>
                <a>Трюмо винтаж Art-deco</a>
                <p><span class="price">15.000 ₽</span> · 1 шт</p>
              </li>
            </ul>
            <!-- <div class="vertical-space S"></div> -->
          </section>

          <section class="cart-items-done" id="cart-items-done">
            <!-- <div class="vertical-space S"></div> -->
            <h1>Выбрано</h1>
            <ul>
              <li>
                <div>
                  <a>Винтажное трюмо, Чехословакия</a>
                  <p><span class="price">40.000 ₽</span> · 1 шт</p>
                </div>
                <button>Убрать</button>
              </li>
            </ul>
            <!-- <div class="vertical-space M"></div>  -->
          </section>

          <div>
            <section class="cart-buttom">
              <p id="total">Итого: <span>0</span>&nbsp&#8381</p>
              <p id="sum-approved"><span>0</span>&nbsp&#8381</p>
              <p id="sum-done"><span>0</span>&nbsp&#8381</p>
              <p id="sum-paid"><span>0</span>&nbsp&#8381</p>
            </section>
            <button class="button-confirm">Подтвердить выбор</button>
          </div>
        </aside>
      </article>

      <div class="vertical-space XL"></div>
    </main>
    <!-- <footer></footer> -->
  </body>
</html>