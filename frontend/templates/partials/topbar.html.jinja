<!-- Заготовка: topbar для залогиненного клиента (не админа). Поправь содержимое. -->
<header class="topbar">
  <div>
    <img src="{{ url_for('static', path='media/logo.svg') }}" alt="Логотип eshe.studio" loading="lazy" draggable="false" />
    <p>Ещё студия</p>
  </div>
  {% if user is none %}
  <div>
    {% block topbar_additional_logged_out %}{% endblock %}
    <button id="login-button" class="login-button" type="button">Войти</button>
  </div>
  {% else %}
	<div>
		<div class="admin-bar-menu">
      {% if user.is_superuser %}
        <a href="{{ url_for('read_admin_page') }}"  class="no-collapse">Админпанель</a>
      {% endif %}
      {% block topbar_additional %}{% endblock %}
			<p class="greet">Привет, {{ user.first_name }}</p>
		</div>

		<button type="button" class="burger-toggle" aria-label="Меню" aria-expanded="false">
			<span></span><span></span><span></span>
		</button>

		<div class="admin-bar-overflow">
			<div class="admin-bar-overflow-items"></div>
			<nav class="nav-pages"></nav>
      {% if user.is_superuser %}
			<a href="{{ url_for('read_admin_page') }}">Админпанель</a>
      {% endif %}
			<button id="logout-button">Выйти</button>
		</div>
	</div>
  {% endif %}
</header>
